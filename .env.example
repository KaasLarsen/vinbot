# Offentlig base-URL til sitemap, canonicals og struktureret data — brug samme host som i Vercel → Domains (primary), typisk www hvis apex redirect’er til www
NEXT_PUBLIC_SITE_URL=https://www.vinbot.dk

# Valgfrit: komma-separerede SoMe-/profil-URL'er til Organization sameAs i JSON-LD
# NEXT_PUBLIC_ORG_SAME_AS=https://www.instagram.com/...,https://...

# Google AdSense
# CLIENT indlæser publisher-scriptet (krav for at Googlebot kan verificere jer ifm. godkendelse).
# Sæt CLIENT så snart I har en pub-ID — også før godkendelse. Scriptet er samtykke-frit.
# /ads.txt genereres automatisk ud fra CLIENT (samme pub-ID som AdSense forventer i ads.txt).
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-7373148222153531
# ACTIVE=true aktiverer faktiske annonce-slots (AdSlot). Slå først til efter godkendelse.
# NEXT_PUBLIC_ADSENSE_ACTIVE=true

# Google Analytics 4 (Measurement ID, starter med G-)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-JB0QD6J59G

# Vercel Cron: påkrævet i produktion/preview. Vercel kører /api/cron/revalidate-feeds hver 6. time
# og sender automatisk Authorization: Bearer <CRON_SECRET>. Manuel flush: curl -H "Authorization: Bearer …" https://vinbot.dk/api/cron/revalidate-feeds
CRON_SECRET=

# Valgfrit: OpenAI til skarpere etiket-genkendelse (Scan etiket) + AI-chat («Hvad har du i køleskabet?»).
# Uden nøgle (eller hvis OpenAI fejler) bruger chat katalog-søgning som fallback; etiket-scan falder tilbage til OCR.
# Sæt i Vercel → Settings → Environment Variables (Production). Værdi UDEN anførselstegn. Skal starte med sk-.
# OPENAI_API_KEY=
# Valgfrit model-navn (default gpt-4o-mini). Brug en chat-model der understøtter json_object.
# OPENAI_VISION_MODEL=gpt-4o-mini
# OPENAI_CHAT_MODEL=gpt-4o-mini
# Valgfrit hvis nøglen er bundet til org/project:
# OPENAI_ORG_ID=
# OPENAI_PROJECT_ID=

# Supabase (direkte CPC-partnerportal)
# Project: https://supabase.com/dashboard — Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role (server only) — partner-signup og prisfald-tilmelding.
SUPABASE_SERVICE_ROLE_KEY=
# Auth → URL configuration: Site URL = https://www.vinbot.dk
# Redirect URLs: https://www.vinbot.dk/partnere/auth/callback , http://localhost:3000/partnere/auth/callback

# Resend: forhandler-tilmelding + forbruger-nyhedsbrev (Contacts/Segments/Topics)
# Opret API-nøgle på https://resend.com — tilføj også som Vercel env (Production + Preview).
# Nøglen skal have tilladelse til Contacts, Segments, Topics og e-mail-afsendelse.
# Uden nøgle returnerer tilmeldingen 503 og du får ingen mails.
RESEND_API_KEY=
# Verificér vinbot.dk i Resend (Domains). onboarding@resend.dev kan kun sende testmails
# til din Resend-konto-email — ikke til tilfældige tilmeldte.
# RESEND_FROM=Vinbot <noreply@vinbot.dk>
# Valgfrit: faste IDs (ellers findes/oprettes segment+topic «Vinbot nyhedsbrev» automatisk).
# RESEND_NEWSLETTER_SEGMENT_ID=
# RESEND_NEWSLETTER_TOPIC_ID=
# Prisfald-mails bruger samme CRON_SECRET til afmeldingslinks (eller PRICE_ALERT_TOKEN_SECRET).
# Topic «Prisfald» oprettes automatisk og er ikke nyhedsbrevet.
# RESEND_PRICE_ALERT_TOPIC_ID=
# PRICE_ALERT_TOKEN_SECRET=
