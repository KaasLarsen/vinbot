{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "crons": [
    {
      "path": "/api/cron/revalidate-feeds",
      "schedule": "0 */12 * * *"
    },
    {
      "path": "/api/cron/force-revalidate-feeds",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/black-friday-live",
      "schedule": "0 */3 * * *"
    }
  ]
}
